{
  "name": "@pymodel/antigravity-mcp",
  "version": "0.1.0",
  "description": "Connect coding agents to Antigravity models for research, code review, and implementation over MCP.",
  "mcpName": "io.github.PyModel/antigravity-mcp",
  "type": "module",
  "bin": {
    "antigravity-mcp": "dist/index.js",
    "antigravity-mcp-install-skills": "scripts/install-skills.mjs",
    "claude-agy-mcp": "dist/index.js",
    "claude-agy-mcp-install-skills": "scripts/install-skills.mjs"
  },
  "files": [
    "dist",
    "skills",
    "scripts/install-skills.mjs",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "docs/multi-client-support.md",
    "assets/*.svg",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --external:@modelcontextprotocol/sdk --external:zod --outfile=dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"if(process.env.NODE_ENV!=='production'&&process.env.HUSKY!=='0')import('husky').then(m=>m.default())\"",
    "check:release": "node scripts/check-release.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "install-skills": "node scripts/install-skills.mjs"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "opencode",
    "pi",
    "antigravity",
    "agy",
    "gemini",
    "delegation"
  ],
  "author": "elkaix (https://github.com/elkaix)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PyModel/antigravity-mcp.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "esbuild": "^0.28.2"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": "prettier --write"
  },
  "os": [
    "darwin",
    "linux"
  ]
}
